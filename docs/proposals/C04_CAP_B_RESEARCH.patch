--- a/test/research/CapPrototype.t.sol
+++ b/test/research/CapPrototype.t.sol
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.26;
+
+import {BondTestBase} from "../utils/BondTestBase.sol";
+
+contract CapPrototypeTest is BondTestBase {
+    function test_twoPermittedDepositsBypassSingleDepositLimit() public {
+        vm.prank(owner);
+        vault.setSingleDepositCaps(101_000 ether, 101_000 ether);
+        address lp = makeAddr("splitLp");
+        (uint256 a0, uint256 a1) = _depositShares(lp, 100_000 ether);
+        assertLe(a0, 101_000 ether);
+        assertLe(a1, 101_000 ether);
+        (a0, a1) = _depositShares(lp, 100_000 ether);
+        assertLe(a0, 101_000 ether);
+        assertLe(a1, 101_000 ether);
+        assertGt(lens.netAssets(vault, c0), 1_101_000 ether);
+        _redeem(lp, 1 ether, false);
+    }
+}
