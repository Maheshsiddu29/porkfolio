+    /// @dev Floor for one fill. Without an adapter: `_effectiveFloor` (static vault floor and curator floor), as before.
+    ///      With an adapter: the static vault floor is not consulted; the floor is max(curator floor, dynamic floor
+    ///      outside the reference band), after the uncertainty breaker; and the inventory floor of the asset paid out
+    ///      must hold after the fill. The adapter is read with one staticcall before any effect; a revert there reverts
+    ///      the fill.
+    function _floorForFill(Allocation storage a, uint256 amountOut) internal view returns (uint256 floor) {
+        IMarketRiskAdapter adapter = riskAdapter;
+        if (address(adapter) == address(0)) return _effectiveFloor(a);
+        Currency out = a.currencyOut;
+        if (sellPolicy[out].halted) revert DirectionHalted(out);
+        IMarketRiskAdapter.Reading memory r = adapter.currentReference();
+        VaultRiskBoundary.checkUncertainty(r.uncertaintyPips, maxUncertaintyPips);
+        (uint256 f0, uint256 f1) = VaultRiskBoundary.dynamicFloors(r.priceX96, r.uncertaintyPips, riskEdgePips);
+        uint256 i = out == asset1 ? 1 : 0;
+        floor = i == 1 ? f1 : f0;
+        uint256 curatorFloor = a.minInPerOutX96;
+        if (curatorFloor > floor) floor = curatorFloor;
+        uint256 target = inventoryTargetPerShare[i];
+        if (target == 0) revert InventoryBoundsNotConfigured();
+        VaultRiskBoundary.checkInventory(
+            _netAssets(out),
+            amountOut,
+            VaultRiskBoundary.inventoryFloor(totalShares, target, inventoryTolerancePips[i])
+        );
+    }
