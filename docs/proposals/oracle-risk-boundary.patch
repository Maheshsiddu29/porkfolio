+    /// @notice Propose installing, replacing or removing (zero) the market-risk adapter. Owner only; executes after
+    ///         `RISK_ADAPTER_DELAY`.
+    function proposeRiskAdapter(address adapter) external onlyOwner {
+        pendingRiskAdapter = adapter;
+        uint256 eta = block.timestamp + RISK_ADAPTER_DELAY;
+        // forge-lint: disable-next-line(unsafe-typecast) timestamps fit 64 bits.
+        pendingRiskAdapterEta = uint64(eta);
+        emit RiskAdapterProposed(adapter, eta);
+    }
+
+    /// @notice Cancel the pending adapter change. Owner or guardian.
+    function cancelRiskAdapter() external {
+        _authorize(true);
+        if (pendingRiskAdapterEta == 0) revert NoPendingRiskAdapter();
+        emit RiskAdapterCancelled(pendingRiskAdapter, msg.sender);
+        pendingRiskAdapter = address(0);
+        pendingRiskAdapterEta = 0;
+    }
+
+    /// @notice Execute the pending adapter change after its delay. Anyone. A new adapter must price this vault's pair
+    ///         and answer now.
+    function executeRiskAdapter() external {
+        uint256 eta = pendingRiskAdapterEta;
+        if (eta == 0) revert NoPendingRiskAdapter();
+        if (block.timestamp < eta) revert RiskAdapterNotReady(eta);
+        address next = pendingRiskAdapter;
+        bytes32 version;
+        if (next != address(0)) {
+            (address c0, address c1,,) = IMarketRiskAdapter(next).pair();
+            if (c0 != Currency.unwrap(asset0) || c1 != Currency.unwrap(asset1)) revert RiskAdapterPairMismatch();
+            IMarketRiskAdapter(next).currentReference();
+            version = IMarketRiskAdapter(next).configVersion();
+        }
+        emit RiskAdapterSet(address(riskAdapter), next, version);
+        riskAdapter = IMarketRiskAdapter(next);
+        pendingRiskAdapter = address(0);
+        pendingRiskAdapterEta = 0;
+    }
+
+    /// @notice Set the vault edge and the uncertainty bound. Owner any values; guardian only a higher edge and a lower
+    ///         bound.
+    function setRiskBounds(uint24 edgePips, uint24 maxUncertainty) external {
+        _authorize(edgePips >= riskEdgePips && maxUncertainty <= maxUncertaintyPips);
+        riskEdgePips = edgePips;
+        maxUncertaintyPips = maxUncertainty;
+        emit RiskBoundsSet(edgePips, maxUncertainty, msg.sender);
+    }
+
+    /// @notice Set the inventory targets and tolerances. Owner any values (tolerance at most 1e6); guardian only the
+    ///         same targets with lower tolerances.
+    function setInventoryBounds(uint256 target0, uint256 target1, uint24 tolerance0, uint24 tolerance1) external {
+        if (tolerance0 > 1_000_000 || tolerance1 > 1_000_000) revert InventoryBoundsNotConfigured();
+        _authorize(
+            target0 == inventoryTargetPerShare[0] && target1 == inventoryTargetPerShare[1]
+                && tolerance0 <= inventoryTolerancePips[0] && tolerance1 <= inventoryTolerancePips[1]
+        );
+        inventoryTargetPerShare = [target0, target1];
+        inventoryTolerancePips = [tolerance0, tolerance1];
+        emit InventoryBoundsSet(target0, target1, tolerance0, tolerance1, msg.sender);
+    }
