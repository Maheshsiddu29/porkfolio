--- a/test/research/CapPrototype.t.sol
+++ b/test/research/CapPrototype.t.sol
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.26;
+
+import {BondTestBase} from "../utils/BondTestBase.sol";
+
+contract MutableCapPrice {
+    uint256 public p0 = 1e18;
+    uint256 public p1 = 1e18;
+    bool public broken;
+
+    function set(uint256 x, uint256 y, bool fail) external {
+        p0 = x;
+        p1 = y;
+        broken = fail;
+    }
+
+    function prices() external view returns (uint256, uint256) {
+        require(!broken, "price unavailable");
+        return (p0, p1);
+    }
+}
+
+contract CapPrototypeTest is BondTestBase {
+    function test_valueBoundaryPriceMovementAndFailure() public {
+        MutableCapPrice oracle = new MutableCapPrice();
+        uint256 shares = 100_000 ether;
+        (uint256 a0, uint256 a1) = lens.previewDeposit(vault, shares);
+        uint256 cap = lens.netAssets(vault, c0) + lens.netAssets(vault, c1) + a0 + a1;
+        vm.prank(owner);
+        vault.setValueCap(address(oracle), cap);
+        address lp = makeAddr("valueLp");
+        _depositShares(lp, shares);
+        address blocked = makeAddr("valueBlocked");
+        _fundLp(blocked, 1 ether, 1 ether);
+        vm.prank(blocked);
+        vm.expectRevert();
+        vault.deposit(1, type(uint256).max, type(uint256).max, blocked);
+
+        oracle.set(1e18, 2e18, false);
+        vm.prank(blocked);
+        vm.expectRevert();
+        vault.deposit(1, type(uint256).max, type(uint256).max, blocked);
+        oracle.set(1e18, 2e18, true);
+        vm.prank(blocked);
+        vm.expectRevert();
+        vault.deposit(1, type(uint256).max, type(uint256).max, blocked);
+
+        uint256 id = _allocate(keyA, c1, 1000 ether);
+        _swap(keyA, true, 100 ether, id);
+        vm.prank(curator);
+        vault.cancelAllocation(id);
+        escrow.sync(id);
+        escrow.settle(id);
+        escrow.realize(type(uint256).max);
+        vm.prank(curator);
+        escrow.claimRefund(curator);
+        _redeem(lp, 1 ether, false);
+        _assertEscrowIdentity();
+    }
+}
