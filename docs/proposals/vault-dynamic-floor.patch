+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.26;
+
+import {IPriceRiskAdapter} from "../../src/interfaces/IPriceRiskAdapter.sol";
+import {ISharedCommitmentVault} from "../../src/interfaces/ISharedCommitmentVault.sol";
+import {VaultTestBase} from "../utils/VaultTestBase.sol";
+
+contract FixedAdapter is IPriceRiskAdapter {
+    uint256 public price;
+    uint256 public unc;
+    bool public down;
+    function set(uint256 p, uint256 u, bool d) external { (price, unc, down) = (p, u, d); }
+    function currentReference() external view returns (Reading memory r) {
+        require(!down, "no reference");
+        r = Reading(price, unc, block.timestamp + 1 days, 2);
+    }
+}
+
+contract DynamicFloorProtoTest is VaultTestBase {
+    FixedAdapter internal adapter;
+
+    function setUp() public override {
+        super.setUp();
+        adapter = new FixedAdapter();
+        adapter.set(PRICE_1_1_X96, 0, false);
+    }
+
+    function _install() internal {
+        vm.prank(owner);
+        vault.proposePriceRiskAdapter(address(adapter));
+        vm.warp(vm.getBlockTimestamp() + 2 days);
+        vault.executePriceRiskAdapter();
+    }
+
+    function _gasSwap(bool zeroForOne, uint256 amt, uint256 id) internal returns (uint256 g) {
+        g = gasleft();
+        _swap(keyA, zeroForOne, amt, id);
+        g -= gasleft();
+    }
+
+    /// Gas of the same Hook A swap with the dynamic floor off and on (adapter cold in each measured call).
+    function test_proto_gas() public {
+        uint256 id = _allocate(keyA, c1, 400_000 ether);
+        _swap(keyA, true, 1_000 ether, id); // warm-up of hook state
+        vm.cool(address(vault));
+        uint256 off = _gasSwap(true, 1_000 ether, id);
+        _install();
+        id = _allocate(keyA, c1, 400_000 ether);
+        vm.cool(address(vault));
+        vm.cool(address(adapter));
+        uint256 on = _gasSwap(true, 1_000 ether, id);
+        emit log_named_uint("swap gas, dynamic floor off", off);
+        emit log_named_uint("swap gas, dynamic floor on (adapter cold)", on);
+    }
+
+    /// Hook A quotes inside a 50 bp band are refused once the reference band says so; with a narrow band they pass.
+    function test_proto_dynamicFloorRefusesInsideBand() public {
+        _install();
+        uint256 id = _allocate(keyA, c1, 400_000 ether);
+        adapter.set(PRICE_1_1_X96, 5_000, false);
+        vm.expectRevert();
+        _swap(keyA, true, 1_000 ether, id);
+        adapter.set(PRICE_1_1_X96 * 101 / 100, 0, false); // currency1 cheaper in reference: Hook A's 1:1 quote passes
+        _swap(keyA, true, 1_000 ether, id);
+        adapter.set(PRICE_1_1_X96, 0, true);
+        vm.expectRevert();
+        _swap(keyA, true, 1_000 ether, id); // no reference: fail closed
+    }
+
+    /// The timelock and guardian rules.
+    function test_proto_adminRules() public {
+        vm.prank(owner);
+        vault.proposePriceRiskAdapter(address(adapter));
+        vm.expectRevert();
+        vault.executePriceRiskAdapter(); // before the delay
+        address g = makeAddr("guardian");
+        vm.prank(owner);
+        vault.setGuardian(g);
+        vm.prank(g);
+        vault.cancelPriceRiskAdapter();
+        vm.prank(g);
+        vm.expectRevert(); // guardian cannot propose
+        vault.proposePriceRiskAdapter(address(adapter));
+        _install();
+        vm.prank(g);
+        vault.setDynamicEdge(10); // raising: allowed
+        vm.prank(g);
+        vm.expectRevert(ISharedCommitmentVault.GuardianCannotIncreaseRisk.selector);
+        vault.setDynamicEdge(5);
+    }
+}
