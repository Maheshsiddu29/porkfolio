+    /// @dev Dynamic floor for selling `currencyOut`, from the adapter's reference mid `P` and uncertainty `u`:
+    ///      selling asset1 needs at least `ceil(ceil(2^192 / P) * (1e6 + u + e) / 1e6)` raw asset0 per raw asset1;
+    ///      selling asset0 needs at least `ceil(P * (1e6 + u + e) / 1e6)` raw asset1 per raw asset0. So the vault never
+    ///      trades inside the band `P * (1 +- u)` the adapter's sources allow, plus edge `e`. The two floors' product is
+    ///      at least `2^192 * (1 + u + e)^2`, so at any fixed reference they are D14-consistent by construction. The
+    ///      adapter is called with a staticcall before any effect; if it reverts, the swap reverts (fail closed).
+    function _dynamicFloor(Currency currencyOut) internal view returns (uint256) {
+        IPriceRiskAdapter.Reading memory r = priceRiskAdapter.currentReference();
+        uint256 widen = _PIPS + r.uncertaintyPips + dynamicEdgePips;
+        if (currencyOut == asset1) {
+            return FullMath.mulDivRoundingUp(
+                FullMath.mulDivRoundingUp(FixedPoint96.Q96, FixedPoint96.Q96, r.priceX96), widen, _PIPS
+            );
+        }
+        return FullMath.mulDivRoundingUp(r.priceX96, widen, _PIPS);
+    }
