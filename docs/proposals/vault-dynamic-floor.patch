--- /dev/null
+++ b/src/interfaces/IPriceRiskAdapter.sol
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.26;
+
+/// @title IPriceRiskAdapter
+/// @notice The read the vault's dynamic floor needs from a price-risk adapter (`src/oracle/PriceRiskAdapter.sol`).
+interface IPriceRiskAdapter {
+    /// @notice A reference read. Same layout as `PriceRiskAdapter.Reading`.
+    struct Reading {
+        uint256 priceX96;
+        uint256 uncertaintyPips;
+        uint256 validUntil;
+        uint256 liveSources;
+    }
+
+    /// @notice The current reference, or a revert when there is none the adapter trusts.
+    function currentReference() external view returns (Reading memory);
+}
