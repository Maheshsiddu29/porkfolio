--- a/test/research/CapPrototype.t.sol
+++ b/test/research/CapPrototype.t.sol
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.26;
+
+import {BondTestBase} from "../utils/BondTestBase.sol";
+
+contract CapPrototypeTest is BondTestBase {
+    function test_exactPostDepositBoundaryAndOtherPaths() public {
+        address lp = makeAddr("capLp");
+        uint256 shares = 100_000 ether;
+        (uint256 amount0, uint256 amount1) = lens.previewDeposit(vault, shares);
+        uint256 cap0 = lens.netAssets(vault, c0) + amount0;
+        uint256 cap1 = lens.netAssets(vault, c1) + amount1;
+        vm.prank(owner);
+        vault.setDepositCaps(cap0, cap1);
+        _depositShares(lp, shares);
+        assertEq(lens.netAssets(vault, c0), cap0);
+        assertEq(lens.netAssets(vault, c1), cap1);
+        address blocked = makeAddr("blockedLp");
+        _fundLp(blocked, 1 ether, 1 ether);
+        vm.prank(blocked);
+        vm.expectRevert();
+        vault.deposit(1, type(uint256).max, type(uint256).max, blocked);
+
+        uint256 id = _allocate(keyA, c1, 1000 ether);
+        _swap(keyA, true, 100 ether, id);
+        assertGt(lens.netAssets(vault, c0), cap0, "trading can raise backing past a deposit-only cap");
+        vm.prank(curator);
+        vault.cancelAllocation(id);
+        escrow.sync(id);
+        escrow.settle(id);
+        escrow.realize(type(uint256).max);
+        vm.prank(curator);
+        escrow.claimRefund(curator);
+        _redeem(lp, 1 ether, false);
+        _assertEscrowIdentity();
+        _assertEquations();
+    }
+
+    function test_earnedFeesMayExceedDepositCapWithoutBeingBlocked() public {
+        uint256 n0 = lens.netAssets(vault, c0);
+        uint256 n1 = lens.netAssets(vault, c1);
+        vm.prank(owner);
+        vault.setDepositCaps(n0, n1);
+        uint256 id = _allocate(keyA, c1, 1000 ether);
+        vm.warp(vm.getBlockTimestamp() + 1 hours);
+        vm.prank(curator);
+        vault.cancelAllocation(id);
+        escrow.sync(id);
+        escrow.settle(id);
+        escrow.realize(type(uint256).max);
+        assertGt(lens.netAssets(vault, c1), n1, "fee realization can exceed deposit-only cap");
+        vm.prank(curator);
+        escrow.claimRefund(curator);
+        _redeem(lp0, 1 ether, false);
+        _assertEscrowIdentity();
+    }
+}
